{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node .devin/hooks/caveman-lite.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(edit|write|apply_patch)$",
      "hooks": [
        {
          "type": "command",
          "command": "node .devin/hooks/format-file.mjs",
          "timeout": 60
        }
      ]
    }
  ]
}

# Postgres (docker compose up -d db)
DATABASE_URL=postgres://pm:pm@localhost:5433/pm
# Used by vitest (docker compose up -d db_test)
TEST_DATABASE_URL=postgres://pm:pm@localhost:5434/pm_test

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Evidence file storage: "disk" (writes to ./storage) or "vercel-blob"
STORAGE_DRIVER=disk
# Required when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
# Text extracted from uploaded Evidence (PDF, DOCX, text) is cut at this many characters
EVIDENCE_EXTRACT_MAX_CHARS=100000

# Seed (npm run db:seed) creates this demo account only
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-123
